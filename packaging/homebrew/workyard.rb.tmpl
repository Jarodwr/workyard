class Workyard < Formula
  desc "Local-first kanban for coordinating AI coding agents"
  homepage "@HOMEPAGE@"
  url "@SOURCE_URL@"
  sha256 "@SOURCE_SHA256@"
  license "@LICENSE@"
  head "@HOMEPAGE@.git", branch: "main"

  depends_on "rust" => :build

  def install
    system "cargo", "install", "--locked", *std_cargo_args(path: "crates/workyard-cli")
    # The CLI finds its Claude plugin at <prefix>/share/workyard/plugin
    (share/"workyard").install "plugin"
  end

  def caveats
    <<~EOS
      Workyard ships a Claude Code plugin. To use it with Claude Code, run:
        claude plugin marketplace add #{opt_share}/workyard/plugin
        claude plugin install workyard@workyard

      Then check that everything is in place:
        workyard doctor
    EOS
  end

  test do
    assert_match "workyard #{version}", shell_output("#{bin}/workyard --version")

    # `doctor` exits 1 when `claude` or `git` is not on PATH, which can
    # happen in the test sandbox; the JSON report is printed either way.
    ENV["WORKYARD_DB"] = testpath/"workyard.db"
    report = JSON.parse(shell_output("#{bin}/workyard doctor --json", [0, 1]))
    assert_equal version.to_s, report.dig("data", "version")
    assert_path_exists share/"workyard/plugin/.claude-plugin/plugin.json"
  end
end
