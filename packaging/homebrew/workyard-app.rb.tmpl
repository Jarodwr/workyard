cask "workyard" do
  version "@VERSION@"
  @DMG_SHA256@

  url "@HOMEPAGE@/releases/download/v#{version}/Workyard-#{version}-aarch64.dmg"
  name "Workyard"
  desc "Local-first kanban for coordinating AI coding agents"
  homepage "@HOMEPAGE@"

  depends_on arch: :arm64
  depends_on macos: :ventura

  app "Workyard.app"
  # No `binary` stanza: the app carries its own CLI for its orchestrator, and linking another
  # `workyard` into the prefix would clash with the `workyard` formula.

  zap trash: [
    "~/Library/Application Support/dev.workyard.app",
    "~/Library/Caches/dev.workyard.app",
    "~/Library/Preferences/dev.workyard.app.plist",
    "~/Library/Saved Application State/dev.workyard.app.savedState",
    "~/Library/WebKit/dev.workyard.app",
  ]

@UNSIGNED_NOTE@
end
