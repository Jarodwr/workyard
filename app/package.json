{
  "name": "workyard-app",
  "private": true,
  "packageManager": "yarn@3.6.1",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "test:graph": "node --experimental-strip-types --test tests/dependency-layout.test.mjs tests/agents.test.mjs tests/card-tabs.test.mjs tests/card-detail.test.mjs tests/markdown.test.mjs tests/view-state.test.mjs tests/new-project.test.mjs",
    "test": "npm run test:graph",
    "tauri": "tauri"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.4",
    "@tauri-apps/api": "2.11.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "motion": "12.42.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@tauri-apps/cli": "2.11.5",
    "@types/react": "19.3.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.1.18",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  }
