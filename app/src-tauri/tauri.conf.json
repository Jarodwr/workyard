{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workyard",
  "version": "0.1.1",
  "identifier": "dev.workyard.app",
  "build": {
    "beforeDevCommand": "../scripts/stage-sidecar.sh --debug && yarn dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "../scripts/stage-sidecar.sh && yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Workyard",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A local kanban that humans and coding agents share.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/workyard"
    ],
    "resources": {
      "../../plugin": "marketplace/plugin",
      "../../.claude-plugin": "marketplace/.claude-plugin"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 600,
          "height": 400
        }
      }
    }
  }
}
