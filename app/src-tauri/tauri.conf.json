{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workyard",
  "version": "0.1.0",
  "identifier": "dev.workyard.app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Workyard", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": ["app"] }
}
